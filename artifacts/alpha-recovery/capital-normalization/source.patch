@@ -0,0 +1,31 @@
+"""Current market repair releases historical tiers without erasing losses."""
+import pandas as pd
+from uquant.risk.capital import apply_capital_overlays
+from uquant.config import DEFAULT_CONFIG
+from uquant.types import AccountState
+
+
+def apply(a, dates, i, *, healthy=True):
+    return apply_capital_overlays(date=dates[i], previous_session=dates[i-1] if i else None,
+        current_inputs_complete=True, independent_damage=not healthy, account=a,
+        cfg=DEFAULT_CONFIG, observed_budget_level=0 if healthy else 3,
+        transition_damage=.1 if healthy else .6, votes=0 if healthy else 4,
+        held_damage_ratio=0 if healthy else .8, capital_dd=.25, operating_dd=0,
+        strategic_damage_guard=False)
+
+
+def test_underwater_capital_tiers_repair_only_on_distinct_healthy_sessions():
+    a=AccountState.empty(2000000); a.capital_budget_level=3; a.capital_peak=2600000
+    dates=pd.bdate_range('2025-01-02',periods=15)
+    for i in range(4):
+        for _ in range(3): apply(a,dates,i)
+        assert a.capital_budget_level==3
+    apply(a,dates,4)
+    assert a.capital_budget_level==2
+    assert a.capital_peak==2600000
+    for i in range(5,10): apply(a,dates,i)
+    assert a.capital_budget_level==1
+    apply(a,dates,9,healthy=False)
+    assert a.capital_budget_level==3
+    apply(a,dates,9)
+    assert a.capital_budget_level==3
