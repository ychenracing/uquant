+def observe_capital_reentry(
+    *,
+    date: pd.Timestamp,
+    previous_session: pd.Timestamp | None,
+    account: AccountState,
+    cfg: SystemConfig,
+    healthy: bool,
+) -> bool:
+    """Release only the historical freeze after distinct, consecutive repairs.
+
+    The capital ladder and its caps retain ownership of historical loss. A bad
+    observation consumes its session so rescanning cannot undo that damage.
+    """
+    streaks = account.risk_streaks
+    session = date.toordinal()
+    previous = previous_session.toordinal() if previous_session is not None else 0
+    last = streaks.get("capital_reentry_session", 0)
+    if not healthy or session < last:
+        streaks["capital_reentry_days"] = 0
+        streaks["capital_reentry_session"] = max(last, session)
+        streaks["capital_reentry_blocked_session"] = max(last, session)
+        return False
+    if streaks.get("capital_reentry_blocked_session", 0) == session:
+        return False
+    if session > last:
+        streaks["capital_reentry_days"] = min(
+            streaks.get("capital_reentry_days", 0) + 1 if last == previous else 1,
+            cfg.capital_budget_repair_days,
+        )
+        streaks["capital_reentry_session"] = session
+    return streaks.get("capital_reentry_days", 0) >= cfg.capital_budget_repair_days
+
+
