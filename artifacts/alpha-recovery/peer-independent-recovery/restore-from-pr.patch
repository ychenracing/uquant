+def _capital_reentry_inputs_complete(
+    *,
+    date: pd.Timestamp,
+    broad: pd.DataFrame,
+    tech: pd.DataFrame,
+    reference_panel: dict[str, pd.DataFrame],
+    user_panel: dict[str, pd.DataFrame],
+    account: AccountState,
+    cfg: SystemConfig,
+    reference_context: ReferenceContext | None,
+) -> bool:
+    """Do not infer repair from absent, stale or nonfinite decision inputs."""
+    context = reference_context
+    # Production deliberately omits the optional group-balanced context. Use
+    # its actual point-in-time risk panel without changing other risk inputs.
+    expected = (
+        context.expected_symbols if context is not None else tuple(
+            symbol for symbol, frame in reference_panel.items()
+            if not frame.empty and frame.index.min() <= date
+        )
+    )
+    if not expected or (context is not None and (
+        context.date != date or context.coverage != 1.0
+        or set(context.visible_symbols) != set(expected)
+    )):
+        return False
+    frames = [broad, tech]
+    for symbol in expected:
+        if symbol not in reference_panel:
+            return False
+        frame = reference_panel[symbol]
+        history = frame.loc[:date]
+        if date not in frame.index or len(history) <= cfg.trend_fast:
+            return False
+        # A newly listed reference has no long horizon yet. Require every
+        # horizon that is defined by its actual past observations; never
+        # excuse missing current data or a nonfinite mature feature.
+        required = ["close", f"ma{cfg.trend_fast}", "ret5", f"ret{cfg.trend_fast}"]
+        if len(history) >= cfg.trend_medium:
+            required.append(f"ma{cfg.trend_medium}")
+        if len(history) > cfg.trend_medium:
+            required.append(f"ret{cfg.trend_medium}")
+        if len(history) > cfg.trend_slow:
+            required.append(f"ret{cfg.trend_slow}")
+        if not all(isfinite(scalar(frame.loc[date], field)) for field in required):
+            return False
+    for symbol, position in account.positions.items():
+        if position.shares > 0:
+            if symbol not in user_panel:
+                return False
+            frames.append(user_panel[symbol])
+    fields = ("close", f"ma{cfg.trend_fast}", f"ma{cfg.trend_medium}", "ret5",
+              f"ret{cfg.trend_fast}", f"ret{cfg.trend_medium}", f"ret{cfg.trend_slow}")
+    return all(
+        date in frame.index and all(isfinite(scalar(frame.loc[date], field)) for field in fields)
+        for frame in frames
+    )
+
+
