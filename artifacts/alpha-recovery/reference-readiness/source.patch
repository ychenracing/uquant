+"""Undefined young-reference horizons are distinct from damaged mature data."""
+import pytest
+from test_capital_reentry import _inputs
+from uquant.risk.assessment import _capital_reentry_inputs_complete
+
+
+def check(inputs):
+    policy, account, dates, panel, _, market, reference, *_ = inputs
+    return _capital_reentry_inputs_complete(date=dates[4], broad=market, tech=market,
+        reference_panel=reference, user_panel=panel, account=account, cfg=policy.cfg, reference_context=None)
+
+
+def young_reference():
+    inputs = _inputs()
+    date = inputs[2][4]
+    reference = inputs[6]
+    symbol = next(iter(reference))
+    frame = reference[symbol].loc[:date].tail(35).copy()
+    frame[['ma60','ret60','ret120']] = float('nan')
+    reference[symbol] = frame
+    return inputs, symbol
+
+
+def test_young_reference_does_not_invent_missing_long_history_or_freeze_other_names():
+    inputs, symbol = young_reference()
+    assert check(inputs)
+    assert inputs[6][symbol]['ret120'].isna().all()
+
+
+@pytest.mark.parametrize('failure', ['missing-current','nan-fast','too-young'])
+def test_current_or_recent_reference_data_remain_required(failure):
+    inputs, symbol = young_reference()
+    date = inputs[2][4]
+    if failure == 'missing-current': inputs[6][symbol] = inputs[6][symbol].drop(date)
+    if failure == 'nan-fast': inputs[6][symbol].loc[date,'ret20'] = float('nan')
+    if failure == 'too-young': inputs[6][symbol] = inputs[6][symbol].tail(10)
+    assert not check(inputs)
+
+
+def test_mature_reference_missing_medium_data_still_blocks():
+    inputs = _inputs()
+    inputs[6][next(iter(inputs[6]))].loc[inputs[2][4],'ret60'] = float('nan')
+    assert not check(inputs)
