new file mode 100644
index 0000000..583312e
--- /dev/null
+++ b/tests/test_paired_strategic_crisis_cut.py
@@ -0,0 +1,34 @@
+"""The additional trim is limited to the physically owned restoration cohort."""
+import pytest
+
+from uquant.config import DEFAULT_CONFIG
+from uquant.risk.capital import apply_capital_overlays
+from uquant.types import AccountState, Position, Tranche
+
+
+@pytest.mark.parametrize('active,lot_epoch,owned_shares,observed,expected', [
+    ('current', 'current', 100, 4, .255),
+    ('current', 'current', 50, 4, .5),
+    ('current', 'old', 100, 4, .5),
+    ('', '', 100, 4, .5),
+    ('current', 'current', 100, 3, .5),
+])
+def test_additional_cut_requires_actual_current_epoch_lots(
+    active, lot_epoch, owned_shares, observed, expected
+):
+    account = AccountState.empty(1000)
+    account.active_strategic_epoch_id = active
+    account.capital_budget_level = 4
+    position = Position('arbitrary', shares=100, avg_cost=5)
+    position.tranches = [Tranche('held', 'CORE', owned_shares, 5, '2024-01-02',
+                                '2024-01-03', 5, epoch_id=lot_epoch)]
+    if owned_shares < 100:
+        position.tranches.append(Tranche('ordinary', 'CORE', 100-owned_shares, 5,
+                                        '2024-01-02', '2024-01-03', 5))
+    account.positions[position.symbol] = position
+    result = apply_capital_overlays(account=account, cfg=DEFAULT_CONFIG,
+        observed_budget_level=observed, transition_damage=.8, votes=4,
+        held_damage_ratio=1, deployed_dd=.25, strategic_damage_guard=False)
+    assert result.overlay_cap == pytest.approx(expected)
+    assert result.freeze_new_risk
+    assert account.positions[position.symbol].shares == 100
