+"""Mature increments use current stock proof and retain ownership boundaries."""
+from dataclasses import replace
+
+import pytest
+from test_recovery_fresh_budget import _book
+
+from uquant.portfolio.leaders.cycle import _pyramid_candidate
+from uquant.types import Position
+
+
+@pytest.mark.parametrize("block", ["none", "immature", "confidence", "owned", "anchor", "exit"])
+def test_mature_increment_uses_own_current_proof(block):
+    book, names, _ = _book(.2, .8)
+    symbol = names[0]
+    book.account.positions[symbol] = Position(symbol, 100, 10.0, "2023-01-02", 12.0)
+    book.leaders[symbol] = replace(book.leaders[symbol], mature=True)
+    book.record(symbol)['entry'] = {'block': 'CONFIRMATION_INCOMPLETE'}
+    if block == 'immature':
+        book.leaders[symbol] = replace(book.leaders[symbol], mature=False)
+    elif block == 'confidence':
+        book.leaders[symbol] = replace(book.leaders[symbol], confidence=0.0)
+    elif block == 'owned':
+        book.owned.add(symbol)
+    elif block == 'anchor':
+        book.account.anchor_weights[symbol] = .2
+    elif block == 'exit':
+        book.proposed[symbol] = .1
+    assert _pyramid_candidate(book, symbol) is (block == 'none')
